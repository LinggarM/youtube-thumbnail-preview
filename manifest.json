{
  "manifest_version": 3,
  "name": "YouTube Thumbnail Preview",
  "version": "1.1",
  "description": "Tampilkan thumbnail video lebih besar saat hover di YouTube",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {}
}